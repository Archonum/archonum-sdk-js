{
  "name": "@archonum/cli",
  "version": "1.1.0",
  "description": "Screenshot any website through a real-device remote Chrome on the archonum gateway.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "archonum": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/papers-ch/archonum-sdk-js.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/papers-ch/archonum-sdk-js/tree/master/packages/cli#readme",
  "keywords": [
    "archonum",
    "cli",
    "screenshot",
    "scraping"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js"
  },
  "dependencies": {
    "@archonum/engine": "workspace:^"
  }
}
