# Copy to .env and fill in. fromEnv() picks up a .env from the current directory
# automatically (e.g. `archonum <url>`, or any script calling ArchonumClient.fromEnv()
# / ArchonumEngine.fromEnv()); `node --env-file=.env …` is still available if you'd
# rather be explicit.
# .env is gitignored — never commit real credentials.

# Required: the API token from your archonum API Key page. It is the only
# secret — the same token authenticates the SDK, CLI, REST API, MCP and gateway.
ARCHONUM_API_TOKEN=

# Optional (defaults shown). Uncomment to override.
#ARCHONUM_GATEWAY=gateway.archonum.com:10900
#ARCHONUM_BASE_URL=https://app.archonum.com
